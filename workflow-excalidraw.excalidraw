      "locked": false,
      "fontSize": 11,
      "fontFamily": 1,
      "text": "DOCUMENT CREATION IN FIREBASE\n1. Generate UUID4 for documentId\n2. Create doc in 'workspaceDocuments' collection\n3. Create doc in 'DocumentOutput' collection\n4. Set metadata: workspaceId, createdBy, documentName\n5. Initialize empty documentOutput array\n6. Use serverTimestamp() for createdAt",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "doc-creation",
      "originalText": "DOCUMENT CREATION IN FIREBASE\n1. Generate UUID4 for documentId\n2. Create doc in 'workspaceDocuments' collection\n3. Create doc in 'DocumentOutput' collection\n4. Set metadata: workspaceId, createdBy, documentName\n5. Initialize empty documentOutput array\n6. Use serverTimestamp() for createdAt",
      "lineHeight": 1.25,
      "baseline": 75,
      "index": "aH",
      "autoResize": true
    },
